# Supabase project the application talks to.
# Copy this file to .env.local and fill in the values from the Supabase
# dashboard (Project settings -> API).
#
# Only the anonymous key belongs here. It is exposed to the browser by design
# and every query it makes is subject to row-level security. A service-role key
# must never be added to a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
